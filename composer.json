{
    "name": "jkghost01/sigra",
    "description": "SIGRA web/backend: SGC and USGS seismic catalog, interactive maps and an experimental citizen sensor network.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/JKGhost01/SIGRA",
    "support": {
        "issues": "https://github.com/JKGhost01/SIGRA/issues",
        "source": "https://github.com/JKGhost01/SIGRA"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "laminas/laminas-escaper": "^2.18",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.14"
    },
    "replace": {
        "codeigniter4/framework": "4.7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "CodeIgniter\\": "system/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**",
            "system/ThirdParty/**"
        ]
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "test": "bash tools/test-architecture.sh",
        "test:mysql": "python3 tools/test-mysql-architecture.py",
        "check-git": "python3 tools/check-git.py",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "scripts-descriptions": {
        "test": "Run deterministic domain, presentation and HTTP checks without production credentials.",
        "test:mysql": "Run integration checks against an explicitly selected disposable sigra_*_test database.",
        "check-git": "Verify that runtime artifacts stay ignored and source files remain visible.",
        "analyse": "Run progressive PHPStan analysis on domain and application code."
    }
}
