# ---------------------------------------------------------------------
# SIGRA · ejemplo de configuración
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
# Nunca subas .env al repositorio.
# ---------------------------------------------------------------------

# development | testing | production
CI_ENVIRONMENT = development

# URL pública con barra final. En local: http://localhost:8080/
app.baseURL = 'http://localhost:8080/'

# Token que deben enviar la app Android y los clientes de la API.
# Inicializa claves locales con php tools/setup-local.php; no publica sus valores.
APP_API_TOKEN =

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = sigra
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ---------------------------------------------------------------------
# Cifrado (obligatorio en producción)
# Genera uno con:
#   php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)) . PHP_EOL;"
# ---------------------------------------------------------------------
encryption.key =

# ---------------------------------------------------------------------
# Fuentes sísmicas (SIGRA 1.0.3+)
# ---------------------------------------------------------------------
quakes.sgcEnabled = true
quakes.globalEnabled = true
quakes.usgsMinMagnitude = 2.5
quakes.windowDays = 5
quakes.cacheSeconds = 300
quakes.dedupeCrossSource = true
quakes.dedupeDistanceKm = 75
quakes.dedupeSeconds = 120
quakes.dedupeMagnitudeDelta = 1.0

# ---------------------------------------------------------------------
# Traducción automática (php spark sigra:translate)
# ---------------------------------------------------------------------
# google y mymemory no requieren clave. Para producción se recomienda
# deepl o una instancia propia de libretranslate.
translator.provider = google
# translator.apiKey =
# translator.endpoint =
translator.rateLimitMs = 120

# ---------------------------------------------------------------------
# Red ciudadana de teléfonos
# ---------------------------------------------------------------------
red.minDevices = 3
red.minAlertMagnitude = 3.0
red.minAlertConfidence = 0.45
red.fcmEnabled = false

# Reportes ciudadanos: privados hasta contrastarlos con un evento SGC.
reports.minParticipants = 3
reports.matchSeconds = 300
reports.matchKm = 150
reports.hourlyLimit = 3
reports.dailyLimit = 10
# HMAC antispam: usa encryption.key si no se especifica otra clave estable.
# reports.hashKey = 'clave-aleatoria-de-al-menos-32-caracteres'

# ---------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------
# logger.threshold = 4

# Architecture: stop new alert publication (detections can still be retained).
red.alertingEnabled = false
# Optional without visitors: schedule php spark sigra:sync (map refresh is automatic).

# Identidad de la aplicación; por defecto se usa Config\Sigra.
# sigra.version = '1.4.0.0'
# sigra.build = '20261120.1'
# sigra.channel = 'stable'

# Catálogos adicionales (independientes de quakes.globalEnabled, que controla USGS).
quakes.emscEnabled = true
quakes.geonetEnabled = true
# quakes.emscEndpoint = 'https://www.seismicportal.eu/fdsnws/event/1/query'
# quakes.geonetEndpoint = 'https://api.geonet.org.nz/quake'

# Los proveedores tienen además un mínimo compartido de 300 s y pausa ante bloqueos.
# quakes.usgsUseSummaryFeed = true

quakes.geofonEnabled = true
quakes.ingvEnabled = true
# quakes.geofonEndpoint = 'https://geofon.gfz.de/eqinfo/list.php?fmt=geojson'
# quakes.ingvEndpoint = 'https://webservices.ingv.it/fdsnws/event/1/query'

# Motor del mapa: cesium (globo) o leaflet (mapa clásico).
# seismicMap.engine = 'cesium'
# seismicMap.cesiumBaseUrl = '/assets/vendor/Cesium/' # Opcional: Build/Cesium 1.146 autoalojado.
# Capas de la beta.2: OSM, Esri y OpenTopoMap; sustituibles por teselas propias.
# seismicMap.osmUrl = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png'
# seismicMap.topoUrl = 'https://tile.opentopomap.org/{z}/{x}/{y}.png'
# seismicMap.satelliteUrl = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
# seismicMap.satelliteCredit = 'Tiles © Esri'
# seismicMap.satelliteMaxLevel = 16


# SGC: resumen completo de cinco días, incluidos eventos menores de magnitud 2.
# sgc.feedUrl = 'https://archive.sgc.gov.co/feed/v1.0.1/summary/five_days_all.json'
