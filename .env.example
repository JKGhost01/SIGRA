# ---------------------------------------------------------------------
# SIGRA · ejemplo de configuración
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
# Nunca subas .env al repositorio.
# ---------------------------------------------------------------------

# development | testing | production
CI_ENVIRONMENT = development

# URL pública con barra final. En local: http://localhost:8080/
app.baseURL = 'http://localhost:8080/'

# Token que deben enviar la app Android y los clientes de la API.
# Inicializa claves locales con php tools/setup-local.php; no publica sus valores.
APP_API_TOKEN =

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = sigra
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ---------------------------------------------------------------------
# Cifrado (obligatorio en producción)
# Genera uno con:
#   php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)) . PHP_EOL;"
# ---------------------------------------------------------------------
encryption.key =

# ---------------------------------------------------------------------
# Fuentes sísmicas (SIGRA 1.0.3+)
# ---------------------------------------------------------------------
quakes.sgcEnabled = true
quakes.globalEnabled = true
quakes.usgsMinMagnitude = 2.5
quakes.windowDays = 5
quakes.cacheSeconds = 60
quakes.dedupeCrossSource = true
quakes.dedupeDistanceKm = 75
quakes.dedupeSeconds = 120
quakes.dedupeMagnitudeDelta = 1.0

# ---------------------------------------------------------------------
# Traducción automática (php spark sigra:translate)
# ---------------------------------------------------------------------
# google y mymemory no requieren clave. Para producción se recomienda
# deepl o una instancia propia de libretranslate.
translator.provider = google
# translator.apiKey =
# translator.endpoint =
translator.rateLimitMs = 120

# ---------------------------------------------------------------------
# Red ciudadana de teléfonos
# ---------------------------------------------------------------------
red.minDevices = 3
red.minAlertMagnitude = 3.0
red.minAlertConfidence = 0.45
red.fcmEnabled = false

# Reportes ciudadanos: privados hasta contrastarlos con un evento SGC.
reports.minParticipants = 3
reports.matchSeconds = 300
reports.matchKm = 150
reports.hourlyLimit = 3
reports.dailyLimit = 10
# HMAC antispam: usa encryption.key si no se especifica otra clave estable.
# reports.hashKey = 'clave-aleatoria-de-al-menos-32-caracteres'

# ---------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------
# logger.threshold = 4

# Architecture: stop new alert publication (detections can still be retained).
red.alertingEnabled = false
# Optional without visitors: schedule php spark sigra:sync (map refresh is automatic).

# Identidad de la aplicación; por defecto se usa Config\Sigra.
# sigra.version = '1.2.1'
# sigra.build = '20261112.5'
# sigra.channel = 'stable'
